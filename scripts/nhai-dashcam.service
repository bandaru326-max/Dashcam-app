[Unit]
Description=NHAI AI Road Survey Dashcam Backend Daemon
After=network.target network-online.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/nhai-dashcam
ExecStart=/home/pi/nhai-dashcam/venv/bin/python run_server.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
